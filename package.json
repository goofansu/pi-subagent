{
  "name": "pi-subagent",
  "version": "2.0.0",
  "description": "Delegate tasks to specialized Pi subagents with isolated context. Any run can be cancelled.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent/index.ts"
    ]
  },
  "license": "MIT",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test && npm run test:conformance",
    "pi:smoke": "node --import tsx scripts/pi-live-smoke.mjs",
    "pi:host-smoke": "node --import tsx scripts/pi-host-live-smoke.mjs pi",
    "claude:smoke": "node --import tsx scripts/claude-live-smoke.mjs",
    "claude:host-smoke": "node --import tsx scripts/pi-host-live-smoke.mjs claude",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node .husky/install.mjs",
    "release:check": "npm run check && npm run pi:smoke && npm run pi:host-smoke && npm run claude:smoke && npm run claude:host-smoke",
    "test": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test \"extensions/subagent/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "test:conformance": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test extensions/subagent/testing/conformance-resumable.test.ts extensions/subagent/testing/conformance-one-shot.test.ts extensions/subagent/testing/conformance-pi.test.ts extensions/subagent/testing/conformance-claude.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "effect": "4.0.0-rc.112"
  }
}
