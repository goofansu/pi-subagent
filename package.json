{
  "name": "pi-subagent",
  "version": "2.0.0-rc.1",
  "description": "Delegate tasks to specialized Pi subagents with isolated context. Any run can be cancelled.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent-v2/index.ts"
    ]
  },
  "license": "MIT",
  "scripts": {
    "check": "npm run typecheck && npm run typecheck:v2 && npm run lint && npm test && npm run test:v2:conformance && npm run codex:protocol:check",
    "codex:protocol:check": "node scripts/check-codex-protocol.mjs",
    "codex:retained-release:check": "node scripts/check-codex-retained-release.mjs",
    "v2:pi:smoke": "node --import tsx scripts/v2-pi-live-smoke.mjs",
    "v2:pi:host-smoke": "node --import tsx scripts/v2-pi-host-live-smoke.mjs pi",
    "v2:claude:smoke": "node --import tsx scripts/v2-claude-live-smoke.mjs",
    "v2:claude:host-smoke": "node --import tsx scripts/v2-pi-host-live-smoke.mjs claude",
    "v2:codex:smoke": "node --import tsx scripts/v2-codex-live-smoke.mjs",
    "v2:codex:host-smoke": "node --import tsx scripts/v2-pi-host-live-smoke.mjs codex",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node .husky/install.mjs",
    "release:check": "npm run check && npm run v2:pi:smoke && npm run v2:pi:host-smoke && npm run v2:claude:smoke && npm run v2:claude:host-smoke && npm run v2:codex:smoke && npm run v2:codex:host-smoke && npm run codex:retained-release:check",
    "test": "node --import tsx --import ./extensions/subagent-v2/suite-setup.ts --test \"extensions/subagent-v2/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"tools/**/*.test.ts\"",
    "test:v2:conformance": "node --import tsx --import ./extensions/subagent-v2/suite-setup.ts --test extensions/subagent-v2/testing/conformance-resumable.test.ts extensions/subagent-v2/testing/conformance-one-shot.test.ts extensions/subagent-v2/testing/conformance-pi.test.ts extensions/subagent-v2/testing/conformance-claude.test.ts extensions/subagent-v2/testing/conformance-codex.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:v2": "tsc --noEmit --project tsconfig.v2.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "effect": "4.0.0-rc.112"
  }
}
