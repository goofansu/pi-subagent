{
  "name": "pi-subagent",
  "version": "1.0.0",
  "description": "Delegate tasks to specialized Pi subagents with isolated context. Any run can be cancelled.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent"
    ]
  },
  "license": "MIT",
  "scripts": {
    "check": "npm run typecheck && npm run typecheck:v2 && npm run lint && npm run test:conformance && npm run test:managed-conformance && npm test && npm run test:v2 && npm run test:v2:conformance && npm run codex:protocol:check",
    "codex:protocol:check": "node scripts/check-codex-protocol.mjs",
    "codex:retained-release:check": "node scripts/check-codex-retained-release.mjs",
    "codex:resume-smoke": "node --import tsx scripts/codex-resume-live-smoke.mjs",
    "codex:smoke": "node --import tsx scripts/codex-live-smoke.mjs",
    "pi:steering-smoke": "node --import tsx scripts/managed-provider-live-smoke.mjs pi steering",
    "pi:resume-smoke": "node --import tsx scripts/managed-provider-live-smoke.mjs pi resume",
    "claude:steering-smoke": "node --import tsx scripts/managed-provider-live-smoke.mjs claude steering",
    "claude:resume-smoke": "node --import tsx scripts/managed-provider-live-smoke.mjs claude resume",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node .husky/install.mjs",
    "release:check": "npm run check && npm run codex:smoke && npm run codex:resume-smoke && npm run pi:steering-smoke && npm run pi:resume-smoke && npm run claude:steering-smoke && npm run claude:resume-smoke && npm run codex:retained-release:check",
    "test": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test \"extensions/subagent/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"tools/**/*.test.ts\"",
    "test:v2": "node --import tsx --import ./extensions/subagent-v2/suite-setup.ts --test \"extensions/subagent-v2/**/*.test.ts\"",
    "test:v2:conformance": "node --import tsx --import ./extensions/subagent-v2/suite-setup.ts --test extensions/subagent-v2/testing/conformance-resumable.test.ts extensions/subagent-v2/testing/conformance-one-shot.test.ts",
    "test:conformance": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test extensions/subagent/harnesses/contract.test.ts extensions/subagent/harnesses/pi/agent.test.ts extensions/subagent/harnesses/claude/harness.test.ts extensions/subagent/harnesses/codex/harness.test.ts",
    "test:managed-conformance": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test extensions/subagent/harnesses/managed-conformance.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:v2": "tsc --noEmit --project tsconfig.v2.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "effect": "4.0.0-rc.112",
    "typebox": "^1.1.38"
  }
}
