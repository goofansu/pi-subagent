{
  "name": "@goofansu/pi-subagent",
  "version": "1.0.2",
  "description": "Delegate tasks to specialized Pi subagents with isolated context. Any run can be cancelled.",
  "type": "module",
  "files": [
    "agents",
    "skills",
    "extensions/subagent/**/*.ts",
    "!extensions/subagent/**/*.test.ts"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent/index.ts"
    ],
    "skills": [
      "./skills/implement-spec/SKILL.md"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goofansu/pi-subagent.git"
  },
  "homepage": "https://github.com/goofansu/pi-subagent#readme",
  "bugs": {
    "url": "https://github.com/goofansu/pi-subagent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test && npm run test:conformance",
    "profiles:smoke": "node --import tsx scripts/bundled-profiles-smoke.mjs",
    "pi:smoke": "node --import tsx scripts/pi-live-smoke.mjs",
    "pi:host-smoke": "node --import tsx scripts/host-live-smoke.mjs pi",
    "claude:smoke": "node --import tsx scripts/claude-live-smoke.mjs",
    "claude:host-smoke": "node --import tsx scripts/host-live-smoke.mjs claude",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node .husky/install.mjs",
    "release:check": "npm run check && npm run pi:smoke && npm run pi:host-smoke && npm run claude:smoke && npm run claude:host-smoke",
    "test": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test \"extensions/subagent/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "test:conformance": "node --import tsx --import ./extensions/subagent/suite-setup.ts --test extensions/subagent/testing/conformance-resumable.test.ts extensions/subagent/testing/conformance-one-shot.test.ts extensions/subagent/testing/conformance-pi.test.ts extensions/subagent/testing/conformance-claude.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-agent-core": "^0.86.0",
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.245",
    "effect": "4.0.0-rc.115"
  }
}
